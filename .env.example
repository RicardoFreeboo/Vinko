# Vinko alfa — copiar a .env.local (y a las variables de entorno del sitio en Netlify).
# JAMÁS commitear claves reales; la service_role de Supabase no sale del servidor.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

SENTRY_DSN=

# Flags del ALPHA FREEZE (CLAUDE.md). OJO: en Next, para que un flag llegue al
# navegador (cliente), DEBE llevar el prefijo NEXT_PUBLIC_. Sin él no hace nada.
# LEGAL_LOCK → botón rewarded oculto en público (default true). Solo Ricardo lo quita.
NEXT_PUBLIC_LEGAL_LOCK=true
# ADS_ENABLED=false → display AdSense no-op (sin hueco gris) y label "modo test"
# en el rewarded. El rewarded de /saldo ya funciona con el stub aunque esté false.
NEXT_PUBLIC_ADS_ENABLED=false

# AdSense / Google Ad Manager (opcionales)
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-7388549278894123
# NEXT_PUBLIC_GAM_REWARDED_UNIT=   # unidad rewarded de Ad Manager cuando exista
