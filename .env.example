# Vinko — variables de entorno. Copia a .env.local para desarrollo y define cada
# una en SU almacén por entorno (ver RUNBOOK-INFRA.md). JAMÁS commitees valores
# reales: la service_role y la privada VAPID no salen del servidor/Edge.
#
# Almacén de cada bloque:
#   · [Vercel]         → Project Settings → Environment Variables (Preview y Production por separado)
#   · [Edge/Supabase]  → Supabase → Project Settings → Edge Functions → Secrets
#   · [GitHub Actions] → repo/entorno → Settings → Secrets and variables → Actions
#   · [BD]             → tabla de la base (la siembra un script/el workflow, no es un env)

# ─────────────────────────────── OBLIGATORIOS ───────────────────────────────

# [Vercel] Cliente/SSR. Públicas por diseño (van al navegador).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# [Edge/Supabase] Service role: SOLO en las Edge Functions, nunca en el cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Cron secret. DEBE COINCIDIR en dos sitios o el push/agente da 403 en silencio:
#   · [Edge/Supabase] CRON_SECRET                    → lo lee la Edge Function
#   · [BD] internal.secrets.cron_secret              → lo manda el cron (cabecera x-cron-secret)
# Siémbralo en la BD con el mismo valor:  CRON_SECRET=… npm run seed-secrets
CRON_SECRET=

# Web push (VAPID). La pública va al cliente; la privada SOLO al Edge. Genera un
# par con `npx web-push generate-vapid-keys` y valida que casan: npm run check-vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=   # [Vercel]  clave pública (base64url)
VAPID_PRIVATE_KEY=              # [Edge/Supabase] clave privada (base64url)

# [GitHub Actions] Despliegue de BD y Edge Functions (token personal de
# supabase.com/dashboard/account/tokens). Secreto por entorno.
SUPABASE_ACCESS_TOKEN=
# [GitHub Actions] VARIABLES (no secretos) por entorno:
#   SUPABASE_PROJECT_REF  → ref del proyecto destino (subdominio <ref>.supabase.co)
#   MIGRATIONS_FROM       → 1 en un proyecto nuevo desde cero; 55 en prod (default)
# [GitHub Actions] (opcional) cadena "Session pooler" para migrar por psql:
# SUPABASE_DB_URL=

# ──────────────────────────────── OPCIONALES ────────────────────────────────

# [Vercel] Analítica de producto.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# [Vercel/Edge] Errores. Cliente y servidor.
SENTRY_DSN=

# [Edge/Supabase] Solo si se usa el agente de tendencias / la porra por voz.
ANTHROPIC_API_KEY=

# ───────────────────────── Flags de lanzamiento (Vercel) ─────────────────────
# OJO: para que un flag llegue al navegador DEBE llevar el prefijo NEXT_PUBLIC_.
NEXT_PUBLIC_LEGAL_LOCK=true      # botón rewarded oculto en público (default true)
NEXT_PUBLIC_ADS_ENABLED=false    # display AdSense no-op y label "modo test"

# AdSense / Google Ad Manager (opcionales)
# NEXT_PUBLIC_ADSENSE_CLIENT=
# NEXT_PUBLIC_GAM_REWARDED_UNIT=

# ───────────────────────────── FUERA DE ALCANCE ─────────────────────────────
# Dinero (rama claude/solo-puntos): STRIPE_*, MONEY_PROVIDER_*. NO se siembran
# aquí ni forman parte del lanzamiento solo-puntos.
